# Refleja el estilo actual del código (no el ideal). Ver frontend/.editorconfig y .prettierrc para el front.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.xml]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,md,sh}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
