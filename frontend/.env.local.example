# Configuración LOCAL del frontend (Vite). Copiar a .env.local (en .gitignore):
#   cp .env.local.example .env.local
# Base de la API del backend local. El front arma /api/... y /auth/... sobre esta URL.
# ⚠️ Hoy el login desde la UI falla porque auth usa /auth/... en vez de /api/auth/... (ver T-002).
VITE_API_URL=http://localhost:8080/v1
