# Configuración LOCAL del backend (Aware Gaming).
# Copiar a src/main/resources/env.properties (lo importa application.properties
# con spring.config.import=optional:env.properties, relativo al classpath).
#   cp src/main/resources/env.properties.example src/main/resources/env.properties
# Los valores sirven tal cual con el docker-compose.yml de la raíz. Son inventados y solo para local.
# env.properties está en .gitignore: nunca commitear el archivo real.

# Motor de base de datos para la URL JDBC (jdbc:<DB_DBMS>://<DB_URL>/<DB_NAME>)
DB_DBMS=postgresql
# host:puerto de la base (servicio "db" del compose publicado en localhost)
DB_URL=localhost:5432
# Nombre de la base (igual a POSTGRES_DB del compose)
DB_NAME=aware_gaming
# Usuario y contraseña de la base (iguales a POSTGRES_USER/POSTGRES_PASSWORD del compose)
DB_USER=aware
DB_PASSWORD=aware_local_bca22f81
# Driver JDBC y dialecto de Hibernate para PostgreSQL
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
DB_DIALECT=PostgreSQLDialect

# Cuenta SMTP para el formulario de soporte (host fijo smtp.gmail.com, ver T-006).
# En local el envío falla (valores ficticios); el resto de la app funciona.
MAIL_USERNAME=support@awaregaming.local
MAIL_PASSWORD=not-a-real-password

# URL del front (hoy no se usa en el código; application.properties la requiere)
FRONTEND_URL=http://localhost:5173
