# Imagen de DESARROLLO LOCAL para `docker compose --profile app` (ver README).
# El Dockerfile de producción (Render) es ./Dockerfile y no se usa en local.
# La configuración llega por variables de entorno desde docker-compose.yml.
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN sh ./mvnw -B -q dependency:go-offline
COPY src/ src/
# Sin tests: necesitan la base levantada (ver scripts/verify.sh)
RUN sh ./mvnw -B -q clean package -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/target/AwareGaming-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
